---
import {siteConfig as c} from '../data/siteConfig';
import content from '../data/pages.json';
const {page:p}=Astro.props;
const isLp=p.slug.startsWith('lp');
const path=p.slug?`/${p.slug}/`:'/';
const url=c.origin+path;
const title=p.title+' | '+c.brand;
const phone=isLp?c.lpPhoneHref:c.phoneHref;
const display=isLp?c.lpPhoneDisplay:c.phoneDisplay;
const call=phone?'tel:'+phone:'#contact';
const formId=c.brand.replaceAll(' ','-')+'-'+(p.slug||'Home')+'-Form';
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Organization','@id':c.origin+'/#organization',name:c.brand,url:c.origin+'/',telephone:c.phoneHref,areaServed:{'@type':'City',name:c.city+', '+c.region}},
 {'@type':'WebPage','@id':url+'#webpage',url,name:title,about:{'@id':c.origin+'/#organization'}},
 ...(!['privacy','terms','lp'].includes(p.slug)?[{'@type':'Service','@id':url+'#service',name:p.title,serviceType:'Sewer line inspection, repair and replacement requests',areaServed:{'@type':'City',name:c.city+', '+c.region},provider:{'@id':c.origin+'/#organization'}}]:[]),
 ...(p.faq.length?[{'@type':'FAQPage','@id':url+'#faq',mainEntity:p.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])
]};
const services=[['Sewer Line Repair','sewer-line-repair'],['Sewer Line Replacement','sewer-line-replacement'],['Trenchless Sewer Repair','trenchless-sewer-repair'],['Sewer Camera Inspection','sewer-camera-inspection'],['Tree Root Sewer Damage','tree-root-sewer-damage']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={p.intro}/><link rel="canonical" href={url}/><meta property="og:url" content={url}/><meta property="og:title" content={title}/>{isLp&&<meta name="robots" content="noindex, nofollow"/>}<link rel="stylesheet" href="/assets/site.css"/><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script></head>
<body><a class="skip" href="#main">Skip to content</a><header class="header"><div class="wrap nav"><a class="brand" href="/">{c.city} <i>Sewer Line</i> Pros</a>{!isLp&&<><button class="menu-button" data-menu-button aria-controls="site-nav" aria-expanded="false" type="button">Menu</button><nav class="navlinks" data-nav id="site-nav" aria-label="Main navigation"><a href="/">Home</a><a href="/#services">Services</a><a href="/#how-it-works">How it works</a><a href="#contact">Contact</a><a class="btn" href={call}>{display||'Request a call'}</a></nav></>}{isLp&&<a class="btn" href={call}>{display||'Request a call'}</a>}</div></header>
<main id="main"><section class="hero"><div class="wrap"><div><h1>{p.title}</h1><p>{p.intro}</p><div class="actions"><a class="btn" href={call} aria-label={'Call '+c.brand}>{display||'Request a call'}</a><a class="btn btn-outline" href={isLp?'#contact':'#services'}>{isLp?'Tell us what happened':'Explore services'}</a></div></div><div class="hero-art" aria-hidden="true"><div class="orbit"></div><div class="pipe"></div><div class="spark"></div></div></div></section>
{p.slug==='lp'&&<section class="section"><div class="wrap grid">{content.pages.filter(x=>x.slug.startsWith('lp/')).map(x=><article class="card"><h2>{x.title}</h2><p>{x.intro}</p><a href={'/'+x.slug+'/'}>View landing page</a></article>)}</div></section>}
{!isLp&&!['privacy','terms'].includes(p.slug)&&<section class="section" id="services"><div class="wrap"><h2>Find the right question to ask about your line</h2><p class="intro">A recurring clog, a root opening and a collapsed pipe call for different work. Use these pages to understand the inspection and repair choices before agreeing to a project.</p><div class="grid">{services.map(([name,slug])=><article class="card"><h3>{name}</h3><p>{content.pages.find(x=>x.slug===slug)?.intro}</p><a href={'/'+slug+'/'}>Read about {name.toLowerCase()}</a></article>)}</div></div></section>}
{p.sections.map((s,i)=><section class={'section '+(i%2?'alt':'')} id={i===p.sections.length-1?'how-it-works':undefined}><div class="wrap article"><h2>{s.heading}</h2>{s.paragraphs.map(t=><p>{t}</p>)}</div></section>)}
{!isLp&&!['privacy','terms'].includes(p.slug)&&<section class="section"><div class="wrap"><h2>Explore Evansville neighborhoods</h2><p class="intro">The service route and repair history matter more than a neighborhood label. These pages connect local housing context with the questions to ask about the pipe at your address.</p><div class="grid">{content.neighborhoods.map(([name,slug])=><article class="card"><h3><a href={'/'+slug+'/'}>{name}</a></h3><p>{content.pages.find(x=>x.slug===slug)?.intro}</p></article>)}</div></div></section>}
{p.faq.length>0&&<section class="section alt"><div class="wrap faq"><h2>Questions about a sewer line in {c.city}</h2>{p.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>}
{!['privacy','terms','lp'].includes(p.slug)&&<section class="section contact" id="contact"><div class="wrap contact-grid"><div><h2>Tell us what is happening with your sewer line</h2><p>Describe which fixtures are affected, when the problem began and any earlier cleaning or repairs. Your request helps a qualified professional understand the symptoms before discussing the next step. Service availability and pipe condition require confirmation.</p><a class="btn" href={call}>{display||'Request a call'}</a></div><div><form class="form" data-lead-form id={formId} name={formId}><input class="honeypot" aria-hidden="true" tabindex="-1" readonly type="text" name="page_site" value={c.brand}/><input class="honeypot" aria-hidden="true" tabindex="-1" readonly type="text" name="page_location" value={p.slug?'Evansville, IN: '+p.title:'Homepage'}/><input class="honeypot" aria-hidden="true" tabindex="-1" readonly type="text" name="page_code" value="HSP"/><label>Your name<input name="full_name" autocomplete="name" required/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" required/></label><label>Email address<input name="email" type="email" autocomplete="email"/></label><label>What is happening?<textarea name="page_details" required placeholder="Tell us which drains are affected and what you have noticed."></textarea></label><label class="honeypot" aria-hidden="true">Leave this blank<input name="website" tabindex="-1" autocomplete="off"/></label><button class="btn" type="submit">Request a call</button><div role="status" aria-live="polite"></div><small>We use your information to respond to your request. Keep people and pets away from sewage and contact a qualified professional for an active backup.</small></form></div></div></section>}
</main><footer class="footer"><div class="wrap"><div class="footer-row"><div><a class="brand" href="/" style="color:white">{c.brand}</a><p>Sewer line information and contact requests for {c.city}, {c.region}. Confirm service availability and the condition of your pipe with a qualified professional.</p></div><div class="footer-guides"><strong>Guides</strong><a href="/sewer-repair-vs-replacement/">Repair or replacement</a><a href="/evansville-sewer-guidance/">Evansville sewer guidance</a></div><div class="footer-guides"><strong>Neighborhoods</strong>{content.neighborhoods.map(([name,slug])=><a href={'/'+slug+'/'}>{name}</a>)}</div><nav aria-label="Footer navigation">{services.map(([name,slug])=><a href={'/'+slug+'/'}>{name}</a>)}<a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav></div><div class="copyright">© 2026 {c.brand}. No service or result is guaranteed.</div></div></footer><a class="fab-deal" href={call} aria-label={'Call '+c.brand}><span class="fab-deal-ico" aria-hidden="true">☎</span><span class="fab-deal-text"><span class="fab-deal-text-k">{c.brand}</span><span class="fab-deal-text-v">{display||'Request a call'}</span></span></a><script is:inline define:vars={{neighborhoods:content.neighborhoods}}>window.siteNeighborhoods=neighborhoods;</script><script is:inline data-tracking-id={c.airchattyTrackingId} defer src="https://api.airchatty.com/js/external-tracking.js"></script><script is:inline defer src="/assets/site.js"></script></body></html>
